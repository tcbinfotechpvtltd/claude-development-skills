#!/usr/bin/env python3
"""eng-os: install, verify and maintain the global Claude Code engineering system.

  eng-os install [--dry-run] [--name="Full Name" --email=you@example.com] [--archive-legacy]
                               back up live config, stage, validate, apply, write manifest.
                               Identity (for the commit rule) comes from --name/--email, then
                               ~/.claude/eng-os/user.json, then `git config --global`.
                               --archive-legacy also archives the agent-skills pack if present.
  eng-os verify                static health checks (zero tokens): drift, settings, hooks, budgets, duplication
  eng-os test                  guard + session hook unit tests in a throwaway sandbox (zero tokens)
  eng-os status                installed version, audit date, backups
  eng-os backups               list backups
  eng-os restore [ID|latest]   restore the live config captured by a backup (default: latest)
  eng-os audit-done            record that a periodic review was completed
  eng-os update [--yes]        fetch release tags, switch the repo to the latest release, run the tests,
                               show the install preview, then install (asks unless --yes)
  eng-os usage [...]           token/tool efficiency from local transcripts (see eng-os-usage.py)
  eng-os eval [...]            behavioural scenarios against real sessions (see eng-os-eval.py)

The repo (where this file lives, or manifest["repo"] when run from the installed copy) is
the single source of truth. Never edit the live copies; edit the repo and re-install.
Python 3.9 compatible, stdlib only.
"""
import datetime
import hashlib
import json
import os
import py_compile
import re
import shutil
import subprocess
import sys
import tempfile

HOME = os.path.expanduser("~")
CLAUDE = os.path.join(HOME, ".claude")
ENGOS = os.path.join(CLAUDE, "eng-os")
MANIFEST = os.path.join(ENGOS, "manifest.json")
BACKUPS = os.path.join(ENGOS, "backups")
USER_FILE = os.path.join(ENGOS, "user.json")    # per-user commit identity, never in the repo
COMPANY_FILE = os.path.join(ENGOS, "company.json")  # company name and selected packs, never in the repo
PERSONAL = os.path.join(ENGOS, "personal.md")   # per-user additions appended to the global CLAUDE.md
PERSONAL_HEADING = "## 9. Personal additions"
HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

# Legacy items replaced by eng-os (addyosmani/agent-skills pack copied into ~/.claude on 2026-06-20).
# They are moved to the backup on first install, never deleted. Agents are kept (heavily used).
LEGACY = (
    ["skills/" + s for s in (
        "api-and-interface-design browser-testing-with-devtools ci-cd-and-automation code-review-and-quality "
        "code-simplification context-engineering debugging-and-error-recovery deprecation-and-migration "
        "documentation-and-adrs doubt-driven-development frontend-ui-engineering git-workflow-and-versioning "
        "idea-refine incremental-implementation interview-me observability-and-instrumentation "
        "performance-optimization planning-and-task-breakdown security-and-hardening shipping-and-launch "
        "source-driven-development spec-driven-development test-driven-development using-agent-skills").split()]
    + ["commands/" + c + ".md" for c in "build code-simplify dev plan review ship spec test webperf".split()]
    + ["hooks/" + h for h in ("SDD-CACHE.md", "SIMPLIFY-IGNORE.md", "sdd-cache-post.sh", "sdd-cache-pre.sh",
                               "session-start-test.sh", "session-start.sh", "simplify-ignore-test.sh", "simplify-ignore.sh")]
)
LEGACY_HOOK_COMMANDS = (".claude/hooks/session-start.sh", ".claude/hooks/sdd-cache", ".claude/hooks/simplify-ignore")
BUDGET = {"claude_md_chars": 10500, "claude_md_lines": 200, "skill_desc_chars": 600, "skill_body_chars": 14000,
          "core_rules_chars": 1000,
          "rule_chars": 5000}
SOURCE_MAX_AGE_DAYS = 120  # cited standards older than this are flagged for re-verification (eng-os-review)


def repo_root():
    if os.path.isdir(os.path.join(HERE, "global")):
        return HERE
    try:
        return json.load(open(MANIFEST))["repo"]
    except (OSError, ValueError, KeyError):
        sys.exit("eng-os: cannot locate the eng-os repo")


def sha(path):
    with open(path, "rb") as fh:
        return hashlib.sha256(fh.read()).hexdigest()


def tilde(p):
    return p.replace(HOME, "~", 1) if p.startswith(HOME) else p


def now():
    return datetime.datetime.now().strftime("%Y%m%d-%H%M%S")


def load_json(path, default=None):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return default


def frontmatter(path):
    text = open(path, errors="replace").read()
    m = re.match(r"---\n(.*?)\n---\n?(.*)", text, re.S)
    if not m:
        return None, text
    fm, key = {}, None
    for line in m.group(1).splitlines():
        mm = re.match(r"^([\w-]+):\s*(.*)$", line)
        if mm:
            key = mm.group(1)
            fm[key] = mm.group(2).strip().strip('"')
        elif key and re.match(r"^\s+-\s+", line):  # YAML list item under the last key
            fm[key] = (fm[key] + " " if fm[key] else "") + line.split("-", 1)[1].strip().strip('"')
    return fm, m.group(2)


# ------------------------------------------------------------------ plan
def load_packs(src):
    """The optional packs defined in global/packs.json: {name: {label, skills, rules, for}}."""
    return (load_json(os.path.join(src, "global", "packs.json"), {}) or {}).get("packs", {})


def build_plan(src, packs=None):
    """Return list of (src_file, live_file) for everything eng-os manages: the core plus the selected packs
    (all packs when `packs` is None)."""
    g = os.path.join(src, "global")
    left_out = {k: d for k, d in load_packs(src).items() if packs is not None and k not in packs}
    skip_skills = {x for d in left_out.values() for x in d.get("skills", [])}
    skip_rules = {x for d in left_out.values() for x in d.get("rules", [])}
    plan = [(os.path.join(g, "CLAUDE.md"), os.path.join(CLAUDE, "CLAUDE.md"))]
    for sub, dest in (("eng-os", ENGOS), ("rules", os.path.join(CLAUDE, "rules")),
                      ("skills", os.path.join(CLAUDE, "skills")), ("agents", os.path.join(CLAUDE, "agents"))):
        base = os.path.join(g, sub)
        for dp, _, files in os.walk(base):
            for f in files:
                if f.endswith((".pyc", ".DS_Store")):
                    continue
                s = os.path.join(dp, f)
                rel = os.path.relpath(s, base)
                if (sub == "skills" and rel.split(os.sep)[0] in skip_skills) or (sub == "rules" and rel in skip_rules):
                    continue
                plan.append((s, os.path.join(dest, rel)))
    for d in ("bin", "tests", "templates"):
        for dp, _, files in os.walk(os.path.join(src, d)):
            for f in files:
                if not f.endswith(".pyc"):
                    s = os.path.join(dp, f)
                    plan.append((s, os.path.join(ENGOS, os.path.relpath(s, src))))
    return plan


def managed_skill_dirs(src, plan=None, manifest_files=None):
    """eng-os skill folders that install may replace: ones in the new plan, or ones an earlier install recorded.
    A folder of the user's own that shares a pack's name is never touched."""
    names = os.listdir(os.path.join(src, "global", "skills"))
    if plan is None:
        return [os.path.join(CLAUDE, "skills", d) for d in names]
    planned = {os.path.relpath(d, os.path.join(CLAUDE, "skills")).split(os.sep)[0] for _, d in plan
               if d.startswith(os.path.join(CLAUDE, "skills") + os.sep)}
    recorded = {f.split("/")[3] for f in (manifest_files or {}) if f.startswith("~/.claude/skills/") and f.count("/") >= 4}
    return [os.path.join(CLAUDE, "skills", d) for d in names if d in planned or d in recorded]


def merge_settings(live, frag, drop_legacy=False):
    out = json.loads(json.dumps(live))  # deep copy
    hooks = out.setdefault("hooks", {})
    for event in list(hooks):
        kept = []
        for entry in hooks[event]:
            cmds = [h.get("command", "") for h in entry.get("hooks", [])]
            if any("eng-os/hooks/" in c or (drop_legacy and any(l in c for l in LEGACY_HOOK_COMMANDS)) for c in cmds):
                continue
            kept.append(entry)
        if kept:
            hooks[event] = kept
        else:
            del hooks[event]
    for event, entries in (frag.get("hooks") or {}).items():
        hooks.setdefault(event, []).extend(entries)
    for kind, rules in ((frag.get("permissions") or {}).items()):
        if isinstance(rules, list):
            cur = out.setdefault("permissions", {}).setdefault(kind, [])
            cur.extend(r for r in rules if r not in cur)
    # env: add eng-os defaults without overriding a variable the user already set
    fenv = frag.get("env") if isinstance(frag.get("env"), dict) else {}
    if fenv:
        if not isinstance(out.get("env"), dict):
            out["env"] = {}
        for k, v in fenv.items():
            out["env"].setdefault(k, v)
    for k, v in frag.items():
        if k not in ("hooks", "permissions", "env"):
            out[k] = v
    return out


def validate_stage(stage):
    errs = []
    for dp, _, files in os.walk(stage):
        for f in files:
            p = os.path.join(dp, f)
            if f.endswith(".py") or (f == "eng-os" and "bin" in dp):
                try:
                    py_compile.compile(p, cfile=os.path.join(tempfile.gettempdir(), "engos-check.pyc"), doraise=True)
                except py_compile.PyCompileError as e:
                    errs.append("syntax: %s: %s" % (p, e.msg))
            elif f.endswith(".json"):
                if load_json(p) is None:
                    errs.append("invalid json: " + p)
            elif f == "SKILL.md":
                fm, _ = frontmatter(p)
                if not fm or not fm.get("name") or not fm.get("description"):
                    errs.append("skill frontmatter missing name/description: " + p)
                elif fm["name"] != os.path.basename(dp):
                    errs.append("skill name %r != dir %r" % (fm["name"], os.path.basename(dp)))
    return errs


def backup(paths, tag):
    bid = now() + "-" + tag
    n = 1
    while os.path.exists(os.path.join(BACKUPS, bid)):  # two installs in the same second must not share a backup
        n += 1
        bid = "%s-%s-%d" % (now(), tag, n)
    root = os.path.join(BACKUPS, bid)
    entries = []
    for p in sorted(set(paths)):
        rel = os.path.relpath(p, CLAUDE)
        exists = os.path.lexists(p)
        entries.append({"path": rel, "existed": exists, "dir": os.path.isdir(p)})
        if exists:
            dst = os.path.join(root, "files", rel)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            if os.path.isdir(p):
                shutil.copytree(p, dst, symlinks=True)
            else:
                shutil.copy2(p, dst)
    os.makedirs(root, exist_ok=True)
    with open(os.path.join(root, "backup.json"), "w") as fh:
        json.dump({"id": bid, "created": datetime.datetime.now().isoformat(timespec="seconds"),
                   "entries": entries}, fh, indent=1)
    return bid


def restore(bid):
    root = os.path.join(BACKUPS, bid)
    meta = load_json(os.path.join(root, "backup.json"))
    if not meta:
        sys.exit("no such backup: " + bid)
    for e in meta["entries"]:
        live = os.path.join(CLAUDE, e["path"])
        if os.path.abspath(live).startswith(BACKUPS):
            continue
        if os.path.isdir(live) and not os.path.islink(live):
            shutil.rmtree(live)
        elif os.path.lexists(live):
            os.remove(live)
        if e["existed"]:
            src = os.path.join(root, "files", e["path"])
            os.makedirs(os.path.dirname(live), exist_ok=True)
            if e["dir"]:
                shutil.copytree(src, live, symlinks=True)
            else:
                shutil.copy2(src, live)
    for e in meta["entries"]:  # drop directories the install created that are now empty
        d = os.path.dirname(os.path.join(CLAUDE, e["path"]))
        while not e["existed"] and d.startswith(CLAUDE + "/") and not d.startswith(ENGOS) and os.path.isdir(d) and not os.listdir(d):
            os.rmdir(d)
            d = os.path.dirname(d)
    print("restored backup %s (%d paths)" % (bid, len(meta["entries"])))


def arg_value(args, name):
    for a in args:
        if a.startswith(name + "="):
            return a.split("=", 1)[1].strip() or None
    return None


def git_global(key):
    try:
        return subprocess.run(["git", "config", "--global", key], capture_output=True, text=True).stdout.strip() or None
    except OSError:
        return None


def identity(args):
    """Commit identity written into the global CLAUDE.md: flags, then user.json, then git config --global."""
    saved = load_json(USER_FILE, {}) or {}
    name = arg_value(args, "--name") or saved.get("name") or git_global("user.name")
    email = arg_value(args, "--email") or saved.get("email") or git_global("user.email")
    if not name or not email or "@" not in email:
        sys.exit('eng-os: commit identity unknown. Run: eng-os install --name="Your Name" --email=you@example.com')
    return {"name": name, "email": email}


def parse_packs(raw, available):
    """`all`, `none`, or a comma list. Empty is an error, so an unset variable never removes packs silently."""
    raw = (raw or "").strip().lower()
    if not raw:
        sys.exit("eng-os: --packs is empty; use --packs=none, --packs=all or a list from: %s" % ", ".join(available))
    if raw == "all":
        return sorted(available)
    if raw == "none":
        return []
    picked = sorted({p.strip() for p in raw.split(",") if p.strip()})
    if "all" in picked or "none" in picked:
        sys.exit("eng-os: use all or none on its own, not inside a list")
    return picked


def check_company_name(name):
    """The name goes into the header of the global CLAUDE.md: one plain line, no template syntax."""
    if len(name) > 80 or re.search(r"[\x00-\x1f\x7f]|\{\{|\}\}|<!--|-->", name):
        sys.exit("eng-os: company name must be one line of at most 80 characters, without {{ }} or <!-- -->")
    return name


def company(args, src):
    """Company name and packs: flags, then company.json, then (upgrading an install from before 0.12.0) the
    company named in the installed CLAUDE.md, with every pack, so nothing changes for existing users."""
    available = load_packs(src)
    saved = load_json(COMPANY_FILE, {}) or {}
    name = arg_value(args, "--company") or saved.get("company")
    flag = next((a.split("=", 1)[1] for a in args if a.startswith("--packs=")), None)
    packs = parse_packs(flag, available) if flag is not None else saved.get("packs")
    if os.path.exists(MANIFEST) and (not name or packs is None):
        # an install from before 0.12.0 (or a company.json without packs): keep its company and every pack
        try:
            with open(os.path.join(CLAUDE, "CLAUDE.md")) as fh:
                m = re.match(r"# Global engineering standards \((.+)\)\s*$", fh.readline())
        except OSError:
            m = None
        name = name or (m.group(1).strip() if m else None)
        packs = sorted(available) if packs is None else packs
    if not name:
        sys.exit('eng-os: company unknown. Run: eng-os install --company="Your Company" --packs=none|all|%s'
                 % ",".join(available))
    if packs is None:
        sys.exit("eng-os: packs not chosen. Add --packs=none, --packs=all or a list from: %s" % ", ".join(available))
    name = check_company_name(name.strip())
    unknown = [p for p in packs if p not in available]
    if unknown:
        sys.exit("eng-os: unknown pack %s (available: %s)" % (", ".join(unknown), ", ".join(available)))
    return {"company": name, "packs": sorted(packs)}


def render_claude_md(src_file, user, personal, out_dir, comp=None, available=None):
    """The global CLAUDE.md with the company, its packs, this user's identity and personal additions filled in.
    Lines tagged `<!-- pack:NAME -->` are kept only when that pack is installed."""
    comp = comp or {"company": "your company", "packs": sorted(available or {})}
    available = available or {}
    labels = [d["label"] for k, d in available.items() if k in comp["packs"]]
    work = ", ".join(labels + ["custom web and mobile apps (Next.js, PHP, Flutter, Python)", "Linux servers and AWS"])
    kept = []
    for line in open(src_file).read().split("\n"):
        m = re.search(r"\s*<!-- pack:([a-z0-9-]+) -->\s*$", line)
        if m:
            if m.group(1) not in comp["packs"]:
                continue
            line = line[:m.start()]
        kept.append(line)
    values = {"GIT_AUTHOR": "%s <%s>" % (user["name"], user["email"]), "COMPANY": comp["company"], "WORK": work}
    text = re.sub(r"\{\{(GIT_AUTHOR|COMPANY|WORK)\}\}", lambda m: values[m.group(1)], "\n".join(kept))
    if personal.strip():
        text = (text.rstrip("\n") + "\n\n" + PERSONAL_HEADING
                + " (from ~/.claude/eng-os/personal.md; may tighten, never relax sections 1-4)\n"
                + personal.strip() + "\n")
    out = os.path.join(out_dir, "CLAUDE.md")
    with open(out, "w") as fh:
        fh.write(text)
    return out


def cmd_install(args):
    dry = "--dry-run" in args
    archive_legacy = "--archive-legacy" in args
    src = repo_root()
    user = identity(args)
    comp = company(args, src)
    available = load_packs(src)
    plan = build_plan(src, comp["packs"])
    frag = load_json(os.path.join(src, "global", "settings.json"))
    if frag is None:
        sys.exit("global/settings.json is missing or invalid")
    settings_path = os.path.join(CLAUDE, "settings.json")
    live_settings = load_json(settings_path, {})
    if os.path.exists(settings_path) and load_json(settings_path) is None:
        sys.exit("~/.claude/settings.json is not valid JSON; fix it before installing")
    merged = merge_settings(live_settings, frag, drop_legacy=archive_legacy)

    # A global CLAUDE.md not written by eng-os is the user's own: keep its text as personal additions.
    live_md = os.path.join(CLAUDE, "CLAUDE.md")
    managed = (load_json(MANIFEST, {}) or {}).get("files", {})
    adopt = os.path.exists(live_md) and tilde(live_md) not in managed and not os.path.exists(PERSONAL)
    personal = open(live_md).read() if adopt else (open(PERSONAL).read() if os.path.exists(PERSONAL) else "")

    stage = tempfile.mkdtemp(prefix="engos-stage-")
    render_dir = tempfile.mkdtemp(prefix="engos-render-")
    try:
        plan[0] = (render_claude_md(plan[0][0], user, personal, render_dir, comp, available), plan[0][1])
        for s, d in plan:
            t = os.path.join(stage, os.path.relpath(d, CLAUDE))
            os.makedirs(os.path.dirname(t), exist_ok=True)
            shutil.copy2(s, t)
        with open(os.path.join(stage, "settings.json"), "w") as fh:
            json.dump(merged, fh, indent=2)
        errs = validate_stage(stage)
        if errs:
            print("\n".join("FAIL " + e for e in errs))
            sys.exit("install aborted: staged files failed validation; live config untouched")
        found = [os.path.join(CLAUDE, l) for l in LEGACY if os.path.lexists(os.path.join(CLAUDE, l))]
        legacy = found if archive_legacy else []
        # rule files of a pack that is no longer selected (skill folders are replaced wholesale below)
        dests = {tilde(d) for _, d in plan}
        stale = [f for f in managed if f.startswith("~/.claude/rules/") and f not in dests and os.path.exists(os.path.expanduser(f))]
        stale_rules = [os.path.expanduser(f) for f in stale if sha(os.path.expanduser(f)) == managed[f]]
        edited_rules = [os.path.expanduser(f) for f in stale if sha(os.path.expanduser(f)) != managed[f]]
        skill_dirs = managed_skill_dirs(src, plan, managed)
        dropped_skills = [d for d in skill_dirs if os.path.isdir(d) and not any(x.startswith(d + os.sep) for _, x in plan)]
        targets = sorted(set([d for _, d in plan] + skill_dirs + [settings_path] + legacy + stale_rules
                             + [os.path.join(ENGOS, x) for x in ("hooks", "bin", "tests", "templates", "manifest.json", "config.json")]))
        changed = [d for s, d in plan if not os.path.exists(d) or sha(s) != sha(d)]
        print("eng-os install from %s" % tilde(src))
        print("  files: %d managed, %d new/changed" % (len(plan), len(changed)))
        for d in changed[:40]:
            print("    ~ " + tilde(d))
        print("  settings.json: %s" % ("changed" if merged != live_settings else "unchanged"))
        print("  commit identity: %s <%s>" % (user["name"], user["email"]))
        print("  company: %s; packs: %s" % (comp["company"], ", ".join(comp["packs"]) or "none"))
        if stale_rules or dropped_skills:
            print("  packs no longer selected, removed: %s" % ", ".join(
                [os.path.basename(d) + "/" for d in dropped_skills] + [os.path.basename(r) for r in stale_rules]))
        if edited_rules:
            print("  kept (you edited them): %s" % ", ".join(tilde(r) for r in edited_rules))
        if adopt:
            print("  your existing ~/.claude/CLAUDE.md is kept: saved to %s and appended as section 9" % tilde(PERSONAL))
        if found and not archive_legacy:
            print("  agent-skills pack items found and kept (%d); --archive-legacy moves them into the backup" % len(found))
        if legacy:
            print("  legacy items to archive (moved into the backup, restorable): %d" % len(legacy))
        if dry:
            print("dry run: nothing written")
            return 0
        if (not changed and merged == live_settings and not legacy and os.path.exists(MANIFEST)
                and load_json(USER_FILE) == user and load_json(COMPANY_FILE) == comp and not stale_rules):
            print("already up to date: nothing written, no backup needed")
            return cmd_verify([])

        bid = backup([t for t in targets if not t.startswith(BACKUPS)], "pre-install")
        print("  backup: %s" % tilde(os.path.join(BACKUPS, bid)))
        try:
            os.makedirs(ENGOS, exist_ok=True)
            with open(USER_FILE, "w") as fh:
                json.dump(user, fh, indent=1)
            with open(COMPANY_FILE, "w") as fh:
                json.dump(comp, fh, indent=1)
            for r in stale_rules:
                os.remove(r)
            if adopt:
                with open(PERSONAL, "w") as fh:
                    fh.write(personal)
            for l in legacy:
                shutil.rmtree(l) if os.path.isdir(l) and not os.path.islink(l) else os.remove(l)
            for sk in skill_dirs:
                if os.path.isdir(sk):
                    shutil.rmtree(sk)
            for sub in ("hooks", "bin", "tests", "templates"):
                p = os.path.join(ENGOS, sub)
                if os.path.isdir(p):
                    shutil.rmtree(p)
            for s, d in plan:
                os.makedirs(os.path.dirname(d), exist_ok=True)
                tmp = d + ".engos-tmp"
                shutil.copy2(s, tmp)
                os.replace(tmp, d)
            for d in (os.path.join(ENGOS, "hooks"), os.path.join(ENGOS, "bin")):
                for f in os.listdir(d):
                    os.chmod(os.path.join(d, f), 0o755)
            tmp = settings_path + ".engos-tmp"
            with open(tmp, "w") as fh:
                json.dump(merged, fh, indent=2)
                fh.write("\n")
            os.chmod(tmp, 0o600)
            os.replace(tmp, settings_path)
            old = load_json(MANIFEST, {}) or {}
            man = {
                "version": open(os.path.join(src, "VERSION")).read().strip(),
                "repo": src,
                "installed_at": datetime.datetime.now().isoformat(timespec="seconds"),
                "last_audit": old.get("last_audit") or datetime.date.today().isoformat(),
                "backup": bid,
                "files": {tilde(d): sha(d) for _, d in plan},
            }
            man["files"][tilde(settings_path)] = sha(settings_path)
            with open(MANIFEST, "w") as fh:
                json.dump(man, fh, indent=1)
        except Exception as e:
            print("install failed (%r); rolling back" % e)
            restore(bid)
            return 1
        print("installed eng-os %s" % man["version"])
    finally:
        shutil.rmtree(stage, ignore_errors=True)
        shutil.rmtree(render_dir, ignore_errors=True)
    return cmd_verify([])


# ------------------------------------------------------------------ verify
def cmd_verify(args):
    res = []

    def check(ok, msg, level="FAIL"):
        res.append(("PASS" if ok else level, msg))

    man = load_json(MANIFEST)
    check(man is not None, "manifest present (%s)" % tilde(MANIFEST))
    if man:
        drift = [p for p, h in man["files"].items()
                 if not os.path.exists(os.path.expanduser(p)) or sha(os.path.expanduser(p)) != h]
        check(not drift, "installed files match reviewed install" + (": drift in %s" % ", ".join(drift[:6]) if drift else ""), "WARN")
    st = load_json(os.path.join(CLAUDE, "settings.json"))
    check(st is not None, "~/.claude/settings.json is valid JSON")
    st = st or {}
    cmds = [h.get("command", "") for es in (st.get("hooks") or {}).values() for e in es for h in e.get("hooks", [])]
    check(any("eng-os/hooks/guard.py" in c for c in cmds), "guard hook wired in settings")
    check(any("eng-os/hooks/session_start.py" in c for c in cmds), "session-start hook wired in settings")
    check(any("eng-os/hooks/prompt_router.py" in c for c in cmds), "prompt-router hook wired in settings")
    check(not any(l in c for c in cmds for l in LEGACY_HOOK_COMMANDS), "no legacy agent-skills hooks wired", "WARN")
    for c in cmds:
        for p in re.findall(r'"\$HOME/([^"]+\.py)"', c):
            check(os.path.isfile(os.path.join(HOME, p)), "hook file exists: ~/" + p)
    pre = (st.get("hooks") or {}).get("PreToolUse", [])
    matchers = [e.get("matcher", "") for e in pre if any("guard.py" in h.get("command", "") for h in e.get("hooks", []))]
    for tool in ("Bash", "Read", "Write", "Edit", "mcp__x__send_message"):
        check(any(re.fullmatch(m if any(ch in m for ch in ".*[]()?+") else "|".join(map(re.escape, m.split("|"))), tool)
                  for m in matchers), "guard matcher covers %s" % tool)
    for py in ("/usr/bin/python3", shutil.which("python3") or ""):
        if py and os.path.exists(py):
            for h in ("guard.py", "session_start.py", "prompt_router.py"):
                p = os.path.join(ENGOS, "hooks", h)
                r = subprocess.run([py, "-c", "import sys; compile(open(sys.argv[1]).read(), sys.argv[1], 'exec')", p],
                                   capture_output=True, text=True)
                check(r.returncode == 0, "%s compiles under %s" % (h, py))
    errlog = os.path.join(ENGOS, "state", "guard-errors.log")
    n = sum(1 for _ in open(errlog)) if os.path.exists(errlog) else 0
    check(n == 0, "guard error log empty (%d entries in %s)" % (n, tilde(errlog)), "WARN")

    cm = os.path.join(CLAUDE, "CLAUDE.md")
    if os.path.exists(cm):
        t, _, extra = open(cm).read().partition("\n" + PERSONAL_HEADING)
        check(len(t) <= BUDGET["claude_md_chars"] and t.count("\n") <= BUDGET["claude_md_lines"],
              "global CLAUDE.md within budget (%d chars ~%d tokens, %d lines)" % (len(t), len(t) // 4, t.count("\n")))
        left = sorted(set(re.findall(r"\{\{[A-Z_]+\}\}|<!-- pack:[a-z0-9-]+ -->", t)))
        check(not left, "global CLAUDE.md fully rendered (company, packs, identity)%s" % (": left " + ", ".join(left) if left else ""))
        if extra:
            res.append(("INFO", "personal additions in CLAUDE.md: %d chars (~%d tokens, from %s)" % (len(extra), len(extra) // 4, tilde(PERSONAL))))
    else:
        check(False, "global CLAUDE.md present")

    skills_dir = os.path.join(CLAUDE, "skills")
    listing = 0
    names = {}
    for d in sorted(os.listdir(skills_dir)) if os.path.isdir(skills_dir) else []:
        p = os.path.join(skills_dir, d, "SKILL.md")
        if not os.path.isfile(p):
            continue
        fm, body = frontmatter(p)
        if not fm:
            owned = man and any(k.startswith("~/.claude/skills/%s/" % d) for k in man["files"])
            check(False, "skill %s has frontmatter%s" % (d, "" if owned else " (your own skill, not eng-os's)"), "FAIL" if owned else "WARN")
            continue
        desc = fm.get("description", "") + fm.get("when_to_use", "")
        if fm.get("disable-model-invocation", "").lower() != "true":
            listing += len(desc) + len(d) + 4
        names[fm.get("name", d)] = d
        managed = man and any(k.startswith("~/.claude/skills/%s/" % d) for k in man["files"])
        if managed:
            check(fm.get("name") == d, "skill %s: name matches dir" % d)
            check(len(desc) <= BUDGET["skill_desc_chars"], "skill %s: description %d chars <= %d" % (d, len(desc), BUDGET["skill_desc_chars"]), "WARN")
            check(len(body) <= BUDGET["skill_body_chars"], "skill %s: body %d chars (~%d tokens) <= budget" % (d, len(body), len(body) // 4), "WARN")
            for ref in re.findall(r"\]\(([\w./-]+\.md)\)", body):
                check(os.path.exists(os.path.join(skills_dir, d, ref)), "skill %s: referenced file %s exists" % (d, ref))
    res.append(("INFO", "user skill listing ~%d chars (~%d tokens) across %d skills" % (listing, listing // 4, len(names))))
    # every skill the prompt router can name carries a short "## Core rules" section, which the hooks insert
    router = os.path.join(ENGOS, "hooks", "prompt_router.py")
    routable = re.findall(r'^\s*\("([a-z-]+)", r"', open(router).read(), re.M) if os.path.exists(router) else []
    for d in routable:
        if not os.path.isdir(os.path.join(skills_dir, d)):
            continue  # a pack this company did not install; the hooks skip it too
        if man and not any(k.startswith("~/.claude/skills/%s/" % d) for k in man["files"]):
            continue  # the user's own skill with a pack's name: not eng-os's to check
        p = os.path.join(skills_dir, d, "SKILL.md")
        m = re.search(r"^## Core rules[^\n]*\n(.*?)(?=^## |\Z)", open(p).read(), re.S | re.M) if os.path.isfile(p) else None
        size = len(m.group(1).strip()) if m else 0
        check(bool(m) and 0 < size <= BUDGET["core_rules_chars"],
              "skill %s: core rules section %s" % (d, "%d chars <= %d" % (size, BUDGET["core_rules_chars"]) if m else "missing"))

    rules_dir = os.path.join(CLAUDE, "rules")
    always = 0
    for f in sorted(os.listdir(rules_dir)) if os.path.isdir(rules_dir) else []:
        p = os.path.join(rules_dir, f)
        fm, body = frontmatter(p)
        scoped = bool(fm and fm.get("paths"))
        if not scoped:
            always += len(body)
        check(len(body) <= BUDGET["rule_chars"], "rule %s %s, %d chars" % (f, "path-scoped" if scoped else "ALWAYS loaded", len(body)), "WARN")
    base = len(open(cm).read()) if os.path.exists(cm) else 0
    res.append(("INFO", "always-loaded eng-os text ~%d tokens (CLAUDE.md + unscoped rules) + ~%d tokens skill listing" % ((base + always) // 4, listing // 4)))

    # freshness of cited standards: every row of docs/SOURCES.md ends with the date it was last checked
    try:
        src = os.path.join(repo_root(), "docs", "SOURCES.md")
    except SystemExit:
        src = None
    if src and os.path.exists(src):
        rows = re.findall(r"^\|\s*([^|]+?)\s*\|.*\|\s*(\d{4}-\d{2}-\d{2})\s*\|\s*$", open(src).read(), re.M)
        today = datetime.date.today()
        stale = [n for n, d in rows if (today - datetime.date.fromisoformat(d)).days > SOURCE_MAX_AGE_DAYS]
        check(bool(rows) and not stale, "cited standards re-checked within %d days (%d in docs/SOURCES.md)%s"
              % (SOURCE_MAX_AGE_DAYS, len(rows), ": stale " + ", ".join(stale[:5]) if stale else ""), "WARN")
    else:
        res.append(("INFO", "docs/SOURCES.md not found; freshness of cited standards not checked"))

    # duplication: identical normalised sentences (>= 9 words) across managed text files
    seen, dups = {}, []
    files = [cm] + [os.path.join(dp, f) for root in (skills_dir, rules_dir) if os.path.isdir(root)
                    for dp, _, fs in os.walk(root) for f in fs if f.endswith(".md")]
    if man:
        files = [f for f in files if tilde(f) in man["files"]]
    for f in files:
        for s in re.split(r"(?<=[.!?])\s+|\n", open(f, errors="replace").read()):
            k = re.sub(r"[^a-z0-9 ]", "", s.lower()).strip()
            if len(k.split()) >= 9:
                if k in seen and seen[k] != f:
                    dups.append((tilde(seen[k]), tilde(f), s.strip()[:70]))
                seen.setdefault(k, f)
    check(not dups, "no duplicated instructions across CLAUDE.md/skills/rules" + ("" if not dups else ": %d, e.g. %s | %s | %s" % ((len(dups),) + dups[0])), "WARN")

    width = max(len(m) for _, m in res)
    for lvl, msg in res:
        print("%-4s %s" % (lvl, msg))
    fails = sum(1 for l, _ in res if l == "FAIL")
    warns = sum(1 for l, _ in res if l == "WARN")
    print("verify: %d checks, %d fail, %d warn" % (len(res), fails, warns))
    return 1 if fails else 0


# ------------------------------------------------------------------ test
def fake_secrets():
    return {
        "{AWS}": "AKIA" + "Z7Q2EXAMPLEKEY4X",
        "{GH}": "ghp_" + "Ab3" * 12,
        "{PRIVKEY}": "-----BEGIN " + "OPENSSH PRIVATE KEY-----\nb3BlbnNzaA\n-----END OPENSSH PRIVATE KEY-----",
        "{RZP}": "rzp_" + "live_" + "Ab12Cd34Ef56Gh",
    }


def cmd_test(args):
    src = repo_root()
    hooks = os.path.join(src, "global", "eng-os", "hooks") if "--installed" not in args else os.path.join(ENGOS, "hooks")
    py = "/usr/bin/python3" if os.path.exists("/usr/bin/python3") else sys.executable
    for a in args:
        if a.startswith("--python="):
            py = a.split("=", 1)[1]
    cases = load_json(os.path.join(src, "tests", "guard_cases.json"))["cases"]
    tmp = tempfile.mkdtemp(prefix="engos-test-")
    root = os.path.realpath(os.path.join(tmp, "proj"))
    state = os.path.join(tmp, "state")
    os.makedirs(os.path.join(root, "sub"))
    os.makedirs(os.path.join(root, "big"))
    os.makedirs(state)
    shutil.copy(os.path.join(src, "global", "eng-os", "config.json"), state)
    os.makedirs(os.path.join(root, "trusted"))
    with open(os.path.join(state, "local.json"), "w") as fh:  # sudo/fs-wipe are listed to prove they cannot be trusted off
        json.dump({"trusted_projects": [{"path": os.path.join(root, "trusted"),
                                         "rules": ["git-protected-push", "sql-destructive", "sudo", "fs-wipe"]}]}, fh)
    open(os.path.join(root, "README.md"), "w").write("root\n")
    open(os.path.join(root, "sub", "CLAUDE.md"), "w").write("# Sub project\nSUB-CANARY: use Decimal for money.\n")
    open(os.path.join(root, "sub", "app.py"), "w").write("print('x')\n")
    os.makedirs(os.path.join(root, "sub", "inner"))
    open(os.path.join(root, "sub", "inner", "CLAUDE.md"), "w").write("INNER-CANARY: nested rules.\n")
    open(os.path.join(root, "sub", "inner", "deep.py"), "w").write("x = 1\n")
    open(os.path.join(root, "big", "CLAUDE.md"), "w").write("# Big\n" + "rule line\n" * 900)
    open(os.path.join(root, "big", "notes.md"), "w").write("n\n")
    subprocess.run(["git", "init", "-q", "-b", "main", os.path.join(root, "subrepo")], check=True)
    env = dict(os.environ, ENGOS_HOME=state, CLAUDE_PROJECT_DIR=root)
    subs = dict(fake_secrets(), **{"{ROOT}": root, "{HOME}": HOME})

    def fill(x):
        if isinstance(x, str):
            for k, v in subs.items():
                x = x.replace(k, v)
            return x
        if isinstance(x, dict):
            return {k: fill(v) for k, v in x.items()}
        return x

    passed, failed = 0, []
    for i, c in enumerate(cases):
        session = "unit-%d" % i
        if c[0] == "ctx":
            session, c = c[1], c[2:]
        kind = c[0]
        if kind == "bash":
            tool, inp, rest = "Bash", {"command": fill(c[1])}, c[2:]
        elif kind == "read":
            tool, inp, rest = "Read", {"file_path": fill(c[1])}, c[2:]
        elif kind == "grep":
            tool, inp, rest = "Grep", {"pattern": "x", "path": fill(c[1])}, c[2:]
        elif kind in ("write", "edit"):
            tool = "Write" if kind == "write" else "Edit"
            inp = {"file_path": fill(c[1]), ("content" if kind == "write" else "new_string"): fill(c[2])}
            if kind == "edit":
                inp["old_string"] = "x"
            rest = c[3:]
        else:
            tool, inp, rest = c[1], fill(c[2]), c[3:]
        expect, needle = rest[0], (rest[1] if len(rest) > 1 else "")
        payload = {"session_id": session, "tool_name": tool, "tool_input": inp, "cwd": root,
                   "hook_event_name": "PreToolUse", "permission_mode": "bypassPermissions"}
        r = subprocess.run([py, os.path.join(hooks, "guard.py")], input=json.dumps(payload),
                           capture_output=True, text=True, env=env, timeout=20)
        out = json.loads(r.stdout) if r.stdout.strip() else {}
        hso = out.get("hookSpecificOutput", {})
        got = hso.get("permissionDecision") or ("context" if hso.get("additionalContext") else "allow")
        text = (hso.get("permissionDecisionReason", "") + " " + hso.get("additionalContext", ""))
        ok = got == expect and (needle in text if needle else True) and r.returncode == 0
        if ok:
            passed += 1
        else:
            failed.append("  #%d %s %s: expected %s%s, got %s %s" % (
                i, tool, json.dumps(inp)[:90], expect, "(%s)" % needle if needle else "", got, text.strip()[:120]))
    errlog = os.path.join(state, "guard-errors.log")
    errors = open(errlog).read() if os.path.exists(errlog) else ""

    # session_start: silent when fresh, speaks when audit is due or files drift
    ss = os.path.join(hooks, "session_start.py")
    def run_ss(source="startup"):
        r = subprocess.run([py, ss], input=json.dumps({"source": source}), capture_output=True, text=True, env=env, timeout=20)
        return r.stdout.strip()
    probe = os.path.join(tmp, "probe.txt")
    open(probe, "w").write("a")
    man = {"last_audit": datetime.date.today().isoformat(), "files": {probe: sha(probe)}}
    json.dump(man, open(os.path.join(state, "manifest.json"), "w"))
    ss_cases = [("fresh install is silent", run_ss() == "")]
    man["last_audit"] = "2000-01-01"
    json.dump(man, open(os.path.join(state, "manifest.json"), "w"))
    ss_cases.append(("overdue audit announced", "self-audit is due" in run_ss()))
    ss_cases.append(("silent on resume/compact", run_ss("compact") == ""))
    open(probe, "w").write("tampered")
    ss_cases.append(("drift announced", "differ from the reviewed install" in run_ss()))
    # weekly update check against a local "remote" holding a newer release tag
    open(probe, "w").write("a")
    origin, clone = os.path.join(tmp, "origin"), os.path.join(tmp, "clone")
    q = {"capture_output": True, "check": True}
    subprocess.run(["git", "init", "-q", "-b", "main", origin], **q)
    subprocess.run(["git", "-C", origin, "-c", "user.name=t", "-c", "user.email=t@t", "commit", "-q", "--allow-empty", "-m", "r"], **q)
    subprocess.run(["git", "-C", origin, "tag", "v9.9.9"], **q)
    subprocess.run(["git", "clone", "-q", origin, clone], **q)
    man.update({"last_audit": datetime.date.today().isoformat(), "repo": clone, "version": "0.1.0"})
    json.dump(man, open(os.path.join(state, "manifest.json"), "w"))
    stamp = os.path.join(state, "state", "update-check.json")
    if os.path.exists(stamp):
        os.remove(stamp)
    ss_cases.append(("newer release announced", "v9.9.9 is available" in run_ss()))
    ss_cases.append(("update check at most weekly", run_ss() == ""))
    os.remove(stamp)
    man["version"] = "9.9.9"
    json.dump(man, open(os.path.join(state, "manifest.json"), "w"))
    ss_cases.append(("silent when on the latest release", run_ss() == ""))
    # project detection at session start
    def run_ss_cwd(cwd):
        r = subprocess.run([py, ss], input=json.dumps({"source": "startup", "cwd": cwd}), capture_output=True, text=True, env=env, timeout=20)
        return r.stdout
    proj = os.path.join(tmp, "odoo_proj")
    os.makedirs(os.path.join(proj, "my_module"))
    os.makedirs(os.path.join(proj, ".git"))
    open(os.path.join(proj, "my_module", "__manifest__.py"), "w").write("{}")
    out = run_ss_cwd(proj)
    ss_cases.append(("Odoo project detected", "`odoo`" in out))
    ss_cases.append(("repo without CLAUDE.md is offered eng-project-init", "eng-project-init" in out))
    web = os.path.join(tmp, "web")
    os.makedirs(web)
    open(os.path.join(web, "package.json"), "w").write('{"dependencies": {"next": "16.4.5"}}')
    open(os.path.join(web, "CLAUDE.md"), "w").write("# Loan app\nDisbursal and KYC flows")
    out = run_ss_cwd(web)
    ss_cases.append(("Next.js and lending detected", "nextjs.md" in out and "fintech-lending" in out and "eng-project-init" not in out))
    ss_cases.append(("home folder is never scanned", run_ss_cwd(os.path.expanduser("~")) == ""))
    nested = os.path.join(tmp, "erp_site")
    os.makedirs(os.path.join(nested, "extra-addons", "school_fees"))
    open(os.path.join(nested, "extra-addons", "school_fees", "__manifest__.py"), "w").write("{}")
    os.makedirs(os.path.join(nested, "app"))
    open(os.path.join(nested, "app", "package.json"), "w").write('{"dependencies": {"next": "16.4.5"}}')
    out = run_ss_cwd(nested)
    ss_cases.append(("stacks one level down detected", "`odoo`" in out and "nextjs.md" in out))
    ws = os.path.join(tmp, "workspace")
    for name in ("a", "b", "c"):
        os.makedirs(os.path.join(ws, name))
        open(os.path.join(ws, name, "package.json"), "w").write("{}")
    ss_cases.append(("a workspace of several projects stays silent", run_ss_cwd(ws) == ""))
    open(os.path.join(ws, "CLAUDE.md"), "w").write("**Domain risk**: <e.g. moves money / stores KYC>\nUses skill fintech-lending")
    ss_cases.append(("no lending match from placeholders or skill names", "fintech-lending" not in run_ss_cwd(ws)))
    lar = os.path.join(tmp, "laravel_app")
    os.makedirs(lar)
    open(os.path.join(lar, "artisan"), "w").write("")
    open(os.path.join(lar, "composer.json"), "w").write("{}")
    out = run_ss_cwd(lar)
    ss_cases.append(("uncovered stack named, general skills apply", "Laravel" in out and "no stack-specific" in out and "PHP +" not in out))
    ss_cases.append(("project outside git without CLAUDE.md is offered eng-project-init", "not under version control" in out and "eng-project-init" in out))
    seen_file = os.path.join(state, "state", "stacks-seen.json")
    ss_cases.append(("detected stacks counted for the review", os.path.exists(seen_file) and "Laravel" in open(seen_file).read()))
    # prompt router: names the matching skills once per session
    pr = os.path.join(hooks, "prompt_router.py")
    def route(prompt, sid="s1"):
        r = subprocess.run([py, pr], input=json.dumps({"prompt": prompt, "session_id": sid}), capture_output=True, text=True, env=env, timeout=20)
        return r.stdout
    out = route("the odoo invoice report test is failing after the upgrade")
    ss_cases.append(("router: odoo + testing", "`odoo`" in out and "`eng-testing`" in out))
    ss_cases.append(("router: skills not repeated in a session", route("another failing odoo test") == ""))
    ss_cases.append(("router: a new skill is still routed", "`eng-docs`" in route("now update the user manual")))
    ss_cases.append(("router: silent for small talk", route("thanks, that looks good") == ""))
    ss_cases.append(("router: silent for slash commands", route("/eng-review please check it", "s2") == ""))
    ss_cases.append(("router: lending", "`fintech-lending`" in route("add an EMI schedule to the loan sanction screen", "s3")))
    ss_cases.append(("router: implementation plan", "`eng-design`" in route("write an implementation plan for the export screen", "s4")))
    ss_cases.append(("router: no design skill for an explanation", "`eng-design`" not in route("can you break this down for me in simple words", "s5")))
    # core rules: inserted with the routing note, once per session, within the size cap
    out = route("the payment webhook test is failing", "s6")
    ss_cases.append(("router: core rules inserted", "`eng-testing` core rules:" in out and "smallest failing test" in out))
    ctx = json.loads(route("design a secure loan disbursal API with tests, docs and a deploy plan", "s7") or "{}")
    ctx = ctx.get("hookSpecificOutput", {}).get("additionalContext", "")
    ss_cases.append(("router: four skills stay under the size cap", ctx.count("core rules:") >= 2 and len(ctx) <= 4500))
    def run_ss_data(payload):
        r = subprocess.run([py, ss], input=json.dumps(payload), capture_output=True, text=True, env=env, timeout=20)
        return r.stdout
    frappe_app = os.path.join(tmp, "frappe_app")
    os.makedirs(frappe_app)
    open(os.path.join(frappe_app, "hooks.py"), "w").write("app_name = 'x'\n")
    open(os.path.join(frappe_app, "modules.txt"), "w").write("X\n")
    out = run_ss_data({"source": "startup", "cwd": frappe_app, "session_id": "fr1"})
    ss_cases.append(("session start: project skill core rules inserted", "`frappe-erpnext` core rules:" in out and "apps/frappe" in out))
    ss_cases.append(("router: project skill not repeated after session start",
                     "`frappe-erpnext`" not in route("bench migrate fails on the frappe doctype", "fr1")))
    out = run_ss_data({"source": "compact", "cwd": frappe_app, "session_id": "fr1"})
    ss_cases.append(("after compaction: project core rules restated", "`frappe-erpnext` core rules:" in out and "self-audit" not in out))
    ss_cases.append(("after compaction: router inserts core rules again", "`eng-testing` core rules:" in route("a test is failing again", "fr1")))
    ss_cases.append(("router: tells Claude to call the Skill tool", "call the Skill tool with `eng-design`" in route("design the data model for refunds", "s8")))
    # install merges eng-os env defaults without overriding the user's own values
    m = merge_settings({"env": {"CLAUDE_CODE_SUBAGENT_MODEL": "opus", "X": "1"}}, {"env": {"CLAUDE_CODE_SUBAGENT_MODEL": "sonnet", "Y": "2"}})
    ss_cases.append(("install: env keeps the user's own value", m.get("env") == {"CLAUDE_CODE_SUBAGENT_MODEL": "opus", "X": "1", "Y": "2"}))
    ss_cases.append(("install: env default added when absent", merge_settings({}, {"env": {"A": "b"}}).get("env") == {"A": "b"}))
    ss_cases.append(("install: env that is not an object is replaced, not a crash", merge_settings({"env": None}, {"env": {"A": "b"}}).get("env") == {"A": "b"}))
    ss_cases.append(("install: a malformed env fragment is ignored", merge_settings({"env": {"A": "x"}}, {"env": ["bad"]}).get("env") == {"A": "x"}))
    # company and packs: the core is company-neutral; packs are installed, rendered and routed only when chosen
    available = load_packs(src)
    user_t = {"name": "T", "email": "t@example.com"}
    none_md = open(render_claude_md(os.path.join(src, "global", "CLAUDE.md"), user_t, "", tmp,
                                    {"company": "Acme Ltd", "packs": []}, available)).read()
    ss_cases.append(("company: CLAUDE.md names the company, not TCB", none_md.startswith("# Global engineering standards (Acme Ltd)") and "TCB" not in none_md))
    ss_cases.append(("company: no packs, no pack rows or labels", "`odoo` |" not in none_md and "ERPNext/Frappe" not in none_md and "Indian digital lending" not in none_md))
    ss_cases.append(("company: fully rendered", not re.search(r"\{\{[A-Z_]+\}\}|<!-- pack:", none_md)))
    all_md = open(render_claude_md(os.path.join(src, "global", "CLAUDE.md"), user_t, "", tmp,
                                   {"company": "Acme Ltd", "packs": sorted(available)}, available)).read()
    ss_cases.append(("company: all packs, rows and labels present", "`fintech-lending` |" in all_md and "Odoo" in all_md and "<!-- pack:" not in all_md))
    rel = lambda plan: {os.path.relpath(d, CLAUDE) for _, d in plan}
    core = rel(build_plan(src, []))
    ss_cases.append(("packs: none leaves out pack skills and rules", not any(p.startswith(("skills/odoo/", "skills/frappe-erpnext/", "skills/fintech-lending/")) or p in ("rules/odoo.md", "rules/frappe-erpnext.md") for p in core)))
    ss_cases.append(("packs: core skills always installed", "skills/eng-security/SKILL.md" in core and "rules/tests.md" in core))
    ss_cases.append(("packs: one pack adds only its files", rel(build_plan(src, ["odoo"])) - core == {p for p in rel(build_plan(src, None)) if p.startswith("skills/odoo/") or p == "rules/odoo.md"}))
    ss_cases.append(("packs: all, none and lists parse", parse_packs("all", available) == sorted(available) and parse_packs("none", available) == [] and parse_packs(" odoo, frappe-erpnext ", available) == ["frappe-erpnext", "odoo"]))
    only = os.path.join(tmp, "skills-core-only")
    for sk in ("eng-testing", "eng-design"):
        shutil.copytree(os.path.join(src, "global", "skills", sk), os.path.join(only, sk))
    env_core = dict(env, ENGOS_SKILLS=only)
    r = subprocess.run([py, pr], input=json.dumps({"prompt": "the odoo invoice report test is failing", "session_id": "pk1"}),
                       capture_output=True, text=True, env=env_core, timeout=20).stdout
    ss_cases.append(("packs: router skips a pack that is not installed", "`eng-testing`" in r and "`odoo`" not in r))
    r = subprocess.run([py, ss], input=json.dumps({"source": "startup", "cwd": frappe_app, "session_id": "pk2"}),
                       capture_output=True, text=True, env=env_core, timeout=20).stdout
    ss_cases.append(("packs: session start points to a missing pack", "not installed on this machine" in r and "`frappe-erpnext` core rules:" not in r))
    def exits(fn, *a):
        try:
            fn(*a)
        except SystemExit:
            return True
        return False
    ss_cases.append(("packs: an empty --packs value is an error, not none", exits(parse_packs, "", available) and exits(parse_packs, "all,odoo", available)))
    ss_cases.append(("company: names with a newline or template syntax are refused", exits(check_company_name, "A\nB") and exits(check_company_name, "{{WORK}}") and exits(check_company_name, "x" * 81)))
    ss_cases.append(("company: brackets in a name are fine", check_company_name("Acme (Pvt) Ltd") == "Acme (Pvt) Ltd"))
    inj = open(render_claude_md(os.path.join(src, "global", "CLAUDE.md"), {"name": "{{COMPANY}}", "email": "x@example.com"}, "", tmp,
                                {"company": "Acme", "packs": []}, available)).read()
    ss_cases.append(("company: one-pass rendering, a value never expands another placeholder", "{{COMPANY}} <x@example.com>" in inj))
    fake = os.path.join(tmp, "user-skills")
    os.makedirs(os.path.join(fake, "odoo"))
    recorded = managed_skill_dirs(src, build_plan(src, []), {"~/.claude/skills/eng-review/SKILL.md": "x"})
    ss_cases.append(("packs: a user's own folder named like a pack is never removed", not any(d.endswith(os.sep + "odoo") for d in recorded)))
    sys.dont_write_bytecode = True
    sys.path.insert(0, hooks)
    import guard as g
    real_home = g.HOME
    try:
        g.HOME = "/private/tmp/h-test"
        ss_cases.append(("guard: home inside a temp folder is not scratch", not g.in_scratch("/private/tmp/h-test/Documents") and not g.in_scratch("/private/tmp")))
        ss_cases.append(("guard: other temp folders still are", g.in_scratch("/private/tmp/build-123")))
    finally:
        g.HOME = real_home
    ev = subprocess.run([py, os.path.join(src, "bin", "eng-os-eval.py"), "--self-test"], capture_output=True, text=True, timeout=60)
    ss_cases.append(("eval: transcript and stream parsers (%s)" % (ev.stdout.strip().splitlines() or ["no output"])[0], ev.returncode == 0))
    for name, ok in ss_cases:
        if ok:
            passed += 1
        else:
            failed.append("  session_start: " + name)

    shutil.rmtree(tmp, ignore_errors=True)
    total = len(cases) + len(ss_cases)
    print("guard/session tests (%s): %d/%d passed" % (py, passed, total))
    if failed:
        print("\n".join(failed))
    if errors:
        print("guard internal errors:\n" + errors)
    return 0 if not failed and not errors else 1


# ------------------------------------------------------------------ misc
def cmd_status(args):
    man = load_json(MANIFEST)
    if not man:
        print("eng-os not installed")
        return 1
    bks = sorted(os.listdir(BACKUPS)) if os.path.isdir(BACKUPS) else []
    print("eng-os %s installed %s from %s" % (man["version"], man["installed_at"], tilde(man["repo"])))
    print("last audit: %s   backups: %d (latest %s)" % (man.get("last_audit"), len(bks), bks[-1] if bks else "-"))
    u = load_json(USER_FILE) or {}
    print("commit identity: %s <%s>%s" % (u.get("name", "?"), u.get("email", "?"),
                                          "   personal additions: " + tilde(PERSONAL) if os.path.exists(PERSONAL) else ""))
    c = load_json(COMPANY_FILE) or {}
    print("company: %s   packs: %s" % (c.get("company", "? (set at the next install)"), ", ".join(c.get("packs") or []) or "none"))
    return 0


def cmd_backups(args):
    for b in sorted(os.listdir(BACKUPS)) if os.path.isdir(BACKUPS) else []:
        meta = load_json(os.path.join(BACKUPS, b, "backup.json"), {})
        print("%s  %d paths" % (b, len(meta.get("entries", []))))
    return 0


def cmd_restore(args):
    bks = sorted(os.listdir(BACKUPS)) if os.path.isdir(BACKUPS) else []
    if not bks:
        sys.exit("no backups")
    bid = args[0] if args and args[0] != "latest" else bks[-1]
    pre = backup([os.path.join(CLAUDE, e["path"]) for e in load_json(os.path.join(BACKUPS, bid, "backup.json"))["entries"]],
                 "pre-restore")
    print("current state saved as backup %s" % pre)
    restore(bid)
    return 0


def cmd_audit_done(args):
    man = load_json(MANIFEST)
    if not man:
        sys.exit("eng-os not installed")
    man["last_audit"] = datetime.date.today().isoformat()
    with open(MANIFEST, "w") as fh:
        json.dump(man, fh, indent=1)
    print("last_audit = " + man["last_audit"])
    return 0


def delegate(script, args):
    return subprocess.call([sys.executable, os.path.join(os.path.dirname(os.path.realpath(__file__)), script)] + args)


def vtuple(s):
    m = re.match(r"v?(\d+)\.(\d+)\.(\d+)$", (s or "").strip())
    return tuple(int(x) for x in m.groups()) if m else None


def cmd_update(args):
    src = repo_root()
    if not os.path.isdir(os.path.join(src, ".git")):
        sys.exit("eng-os: %s is not a git clone; update it by hand" % tilde(src))

    def git(*a):
        return subprocess.run(["git", "-C", src] + list(a), capture_output=True, text=True, check=True).stdout.strip()

    if git("status", "--porcelain"):
        sys.exit("eng-os: the repo has uncommitted changes; commit or stash them first")
    subprocess.run(["git", "-C", src, "fetch", "--tags", "--quiet", "origin"], check=True)
    releases = sorted((v, t) for t in git("tag", "--list", "v*").split() for v in [vtuple(t)] if v)
    if not releases:
        sys.exit("eng-os: no release tags found")
    latest = releases[-1][1]
    if git("rev-parse", "HEAD") != git("rev-list", "-n", "1", latest):
        branch = subprocess.run(["git", "-C", src, "symbolic-ref", "--quiet", "--short", "HEAD"],
                                capture_output=True, text=True).stdout.strip()
        unreleased = branch and (branch != "main" or git("log", "--oneline", "origin/main..HEAD"))
        if unreleased:
            print("the repo has unreleased work on branch %s (a maintainer copy): left as it is; run `install` yourself" % branch, flush=True)
            return 0
        git("checkout", "--quiet", latest)
        print("switched the repo to release %s" % latest, flush=True)
    else:
        print("the repo is at release %s" % latest, flush=True)
    cli = [sys.executable, os.path.join(src, "bin", "eng-os")]
    if subprocess.run(cli + ["test"]).returncode:
        sys.exit("eng-os: tests failed on %s; nothing installed" % latest)
    subprocess.run(cli + ["install", "--dry-run"])
    if "--yes" not in args:
        try:
            answer = input("Install %s? [y/N] " % latest)
        except EOFError:
            answer = ""
        if answer.strip().lower() != "y":
            print("not installed")
            return 0
    return subprocess.run(cli + ["install"]).returncode


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    cmd, args = sys.argv[1], sys.argv[2:]
    table = {"install": cmd_install, "verify": cmd_verify, "test": cmd_test, "status": cmd_status,
             "backups": cmd_backups, "restore": cmd_restore, "audit-done": cmd_audit_done, "update": cmd_update,
             "usage": lambda a: delegate("eng-os-usage.py", a), "eval": lambda a: delegate("eng-os-eval.py", a)}
    if cmd not in table:
        sys.exit("unknown command %r (see eng-os --help)" % cmd)
    return table[cmd](args)


if __name__ == "__main__":
    sys.exit(main())
